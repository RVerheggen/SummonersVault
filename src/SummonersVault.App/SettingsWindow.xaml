<Window x:Class="SummonersVault.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="720" Height="820" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16">
        <Border Style="{StaticResource Panel}" Padding="28">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Security, locking, and League Client preferences" Style="{StaticResource MutedText}" Margin="0,5,0,20"/></StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="UPDATES" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LastUpdateCheck" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check for updates" AutomationProperties.Name="Check for updates" Click="CheckUpdates_Click"/>
                                </Grid>
                                <CheckBox x:Name="AutomaticUpdates" Content="Automatically check for updates" AutomationProperties.Name="Automatically check for updates" Margin="0,12,0,0"/>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                <TextBlock Text="Checks run only while SummonersVault is open. Updates are downloaded only after you approve them." Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="LOCKING" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="Lock after inactivity" Margin="0,16,0,6"/><ComboBox x:Name="AutoLock"><ComboBoxItem Tag="5" Content="5 minutes"/><ComboBoxItem Tag="10" Content="10 minutes"/><ComboBoxItem Tag="30" Content="30 minutes"/><ComboBoxItem Tag="60" Content="60 minutes"/><ComboBoxItem Tag="never" Content="Never"/></ComboBox><CheckBox x:Name="SessionLock" Content="Lock on Windows session lock or sleep" Margin="0,12,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="LEAGUE CLIENT" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="Riot Games installation folder (optional)" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LeaguePath" AutomationProperties.Name="Riot Games installation folder"/><Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click"/></Grid><TextBlock Text="Choose the Riot Games, Riot Client, or League of Legends folder. Leave blank for automatic discovery." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="ARTWORK" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><CheckBox x:Name="CommunityDragonDownloads" Content="Download public artwork from CommunityDragon" AutomationProperties.Name="Download public artwork from CommunityDragon" Margin="0,14,0,0"/><TextBlock Text="Public asset paths only. No account identifiers or credentials are sent." Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock x:Name="CacheSize" Style="{StaticResource MutedText}" Margin="0,8,0,8"/><Button Content="Clear artwork cache" AutomationProperties.Name="Clear artwork cache" Click="ClearArtwork_Click" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="CHANGE MASTER PASSWORD" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="Current password" Margin="0,16,0,6"/><PasswordBox x:Name="CurrentPassword"/><TextBlock Text="New password" Margin="0,12,0,6"/><PasswordBox x:Name="NewPassword"/><TextBlock Text="Confirm new password" Margin="0,12,0,6"/><PasswordBox x:Name="ConfirmPassword"/><TextBlock Text="Minimum 8 characters; a 12+ character passphrase is recommended." Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Save settings" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Save_Click"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
