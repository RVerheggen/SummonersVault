<Window x:Class="SummonersVault.App.BackupConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve import conflict"
        Width="560" Height="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <TextBlock Text="Account already exists" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="AccountNameText" Foreground="{StaticResource HighlightBrush}"
                           FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="The imported backup contains an account that matches one in this vault. Choose which version to keep."/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HighlightBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="KEEP CURRENT" Foreground="{StaticResource HighlightBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Retain the account already stored in this vault." Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="USE IMPORTED" Foreground="{StaticResource HighlightBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Replace the matching account with the backup version." Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel import" IsCancel="True" AutomationProperties.Name="Cancel backup import"/>
            <Button Content="Use imported" Margin="10,0,0,0" Click="UseImported_Click"
                    AutomationProperties.Name="Use imported account"/>
            <Button x:Name="KeepCurrentButton" Content="Keep current" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Margin="10,0,0,0" Click="KeepCurrent_Click"
                    AutomationProperties.Name="Keep current account"/>
        </StackPanel>
    </Grid>
</Window>
