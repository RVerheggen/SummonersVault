<Window x:Class="SummonersVault.App.AccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Account details" Width="880" Height="720" MinWidth="880" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
  <Grid Margin="24" Background="{StaticResource BackgroundBrush}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="Heading" Text="Add account" FontSize="28" FontWeight="SemiBold"/><TextBlock Style="{StaticResource MutedText}" Text="Credentials stay inside the encrypted local vault." Margin="0,4,0,22"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Label"/><TextBox x:Name="LabelText" AutomationProperties.Name="Account label" Margin="0,6,0,14"/><TextBlock Text="Username"/><TextBox x:Name="LoginText" AutomationProperties.Name="Username" Margin="0,6,0,14"/><TextBlock Text="Password"/><PasswordBox x:Name="PasswordText" AutomationProperties.Name="Account password" Margin="0,6,0,4"/><TextBlock x:Name="PasswordHint" Style="{StaticResource MutedText}" Text="Required for a new account." FontSize="11"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Region"/><ComboBox x:Name="RegionText" SelectedIndex="0" Margin="0,6,0,14" AutomationProperties.Name="Region"><ComboBoxItem Content="EUW"/><ComboBoxItem Content="EUNE"/><ComboBoxItem Content="NA"/><ComboBoxItem Content="KR"/><ComboBoxItem Content="BR"/><ComboBoxItem Content="JP"/><ComboBoxItem Content="LAN"/><ComboBoxItem Content="LAS"/><ComboBoxItem Content="OCE"/><ComboBoxItem Content="TR"/></ComboBox><TextBlock Text="Role tags"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><ToggleButton x:Name="TopRole" Style="{StaticResource RoleChip}" Content="Top" AutomationProperties.Name="Top role"/><ToggleButton x:Name="JungleRole" Style="{StaticResource RoleChip}" Content="Jungle" AutomationProperties.Name="Jungle role"/><ToggleButton x:Name="MidRole" Style="{StaticResource RoleChip}" Content="Mid" AutomationProperties.Name="Mid role"/><ToggleButton x:Name="BotRole" Style="{StaticResource RoleChip}" Content="Bot" AutomationProperties.Name="Bot role"/><ToggleButton x:Name="SupportRole" Style="{StaticResource RoleChip}" Content="Support" Margin="0" AutomationProperties.Name="Support role"/></StackPanel></StackPanel>
      </Grid>
      <TextBlock Text="Notes" Margin="0,20,0,6"/><TextBox x:Name="NotesText" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Account notes"/>
      <Border x:Name="LeaguePanel" Style="{StaticResource Panel}" Margin="0,20,0,0"><StackPanel><TextBlock Text="LEAGUE SNAPSHOT" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock x:Name="LeagueIdentity" Margin="0,10,0,0"/><TextBlock x:Name="LeagueSummary" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0" AutomationProperties.Name="Currency balances"><Image Source="Assets/rp.png" Width="18" Height="18" Stretch="Uniform" ToolTip="RP" AutomationProperties.Name="RP icon"/><TextBlock Text="RP:" Style="{StaticResource MutedText}" Margin="6,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="RiotPointsValue" VerticalAlignment="Center"/><Border Width="1" Height="16" Background="{StaticResource BorderSubtleBrush}" Margin="12,0"/><Image Source="Assets/blue-essence.png" Width="18" Height="18" Stretch="Uniform" ToolTip="Blue Essence" AutomationProperties.Name="Blue Essence icon"/><TextBlock Text="Blue Essence:" Style="{StaticResource MutedText}" Margin="6,0,4,0" VerticalAlignment="Center"/><TextBlock x:Name="BlueEssenceValue" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="MatchSummary" Margin="0,10,0,0"/><TextBlock x:Name="OwnershipSummary" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="Champions" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock x:Name="ChampionNames" Style="{StaticResource MutedText}"/><TextBlock Text="Skins" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock x:Name="SkinNames" Style="{StaticResource MutedText}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DeleteButton" Content="Delete account" Foreground="{StaticResource DangerBrush}" Click="Delete_Click" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True"/><Button Style="{StaticResource PrimaryButton}" Content="Save account" Margin="10,0,0,0" Click="Save_Click"/></StackPanel></Grid>
  </Grid>
</Window>
