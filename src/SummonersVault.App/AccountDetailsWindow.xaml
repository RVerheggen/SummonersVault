<Window x:Class="SummonersVault.App.AccountDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SummonersVault.App.Controls" Title="League account details" Width="1120" Height="800" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
  <Grid Background="{StaticResource BackgroundBrush}" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><TextBlock Text="SV" Foreground="{StaticResource HighlightBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Account.ProfileIconBytes, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill"/></Grid></Border>
      <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="{Binding RiotId}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding ProfileLine}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding RoleLine}" Margin="0,8,0,0"/><TextBlock Text="{Binding LastPlayed}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding SyncSummary}" Foreground="{StaticResource HighlightBrush}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Image Source="Assets/Currencies/rp.png" Width="22" Height="22"/><TextBlock Text="{Binding RiotPoints}" Margin="7,2,18,0"/><Image Source="Assets/Currencies/blue-essence.png" Width="22" Height="22"/><TextBlock Text="{Binding BlueEssence}" Margin="7,2,0,0"/></StackPanel><WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Copy username" AutomationProperties.Name="Copy username" Click="CopyUsername_Click"/><Button Content="Copy password" AutomationProperties.Name="Copy password" Click="CopyPassword_Click" Margin="8,0,0,0"/><Button Content="Sync" AutomationProperties.Name="Synchronize account" Click="Sync_Click" Margin="8,0,0,0"/><Button Content="Open League" AutomationProperties.Name="Open League" Click="OpenLeague_Click" Margin="8,0,0,0"/><Button Content="Edit" AutomationProperties.Name="Edit account" Click="Edit_Click" Margin="8,0,0,0"/></WrapPanel></StackPanel>
    </Grid></Border>
    <TabControl Grid.Row="2" AutomationProperties.Name="Account details sections">
      <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Overview" Style="{StaticResource SectionHeading}"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="NOTES" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,10,0,0"/><Separator Margin="0,18"/><TextBlock Text="{Binding OwnershipSummary}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SyncSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding LastPlayed}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Champions"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ChampionQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search champions"/><TextBlock Grid.Column="1" Text="{Binding ChampionCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="2" ItemsSource="{Binding ChampionRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Padding="0" Height="190"><Grid><controls:ArtworkImage AssetPath="{Binding First.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/><Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" Padding="14,10"><TextBlock Text="{Binding First.Name}" FontSize="17" FontWeight="SemiBold"/></Border></Grid></Border><Border Grid.Column="2" Visibility="{Binding Second, Converter={StaticResource NullVisibility}}" Style="{StaticResource Panel}" Padding="0" Height="190"><Grid><controls:ArtworkImage AssetPath="{Binding Second.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/><Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" Padding="14,10"><TextBlock Text="{Binding Second.Name}" FontSize="17" FontWeight="SemiBold"/></Border></Grid></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="Skins"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SkinQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search skins and champions"/><TextBlock Grid.Column="1" Text="{Binding SkinCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="2" ItemsSource="{Binding SkinRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Padding="0" Height="190"><Grid><controls:ArtworkImage AssetPath="{Binding First.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/><Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" Padding="14,8"><StackPanel><TextBlock Text="{Binding First.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding First.Subtitle}" Style="{StaticResource MutedText}"/></StackPanel></Border></Grid></Border><Border Grid.Column="2" Visibility="{Binding Second, Converter={StaticResource NullVisibility}}" Style="{StaticResource Panel}" Padding="0" Height="190"><Grid><controls:ArtworkImage AssetPath="{Binding Second.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/><Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" Padding="14,8"><StackPanel><TextBlock Text="{Binding Second.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Second.Subtitle}" Style="{StaticResource MutedText}"/></StackPanel></Border></Grid></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="Ranked"><ListBox ItemsSource="{Binding RankRows}" Margin="20" Background="{StaticResource TransparentBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding First.Icon}" Width="72" Height="72" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding First.Queue}" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding First.RankText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding First.Record}" Margin="0,6,0,0"/><TextBlock Text="{Binding First.WinRate}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding First.Placement}" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/></StackPanel></Grid></Border><Border Grid.Column="2" Visibility="{Binding Second, Converter={StaticResource NullVisibility}}" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Second.Icon}" Width="72" Height="72" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Second.Queue}" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Second.RankText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="{Binding Second.Record}" Margin="0,6,0,0"/><TextBlock Text="{Binding Second.WinRate}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Second.Placement}" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"/></StackPanel></Grid></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
      <TabItem Header="Crafting"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Style="{StaticResource Panel}" Padding="12,8"><StackPanel Orientation="Horizontal"><Image Source="Assets/Currencies/orange-essence.png" Width="24" Height="24" AutomationProperties.Name="Orange Essence icon"/><TextBlock Text="Orange Essence" Style="{StaticResource MutedText}" Margin="8,2,6,0"/><TextBlock Text="{Binding OrangeEssence}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Padding="12,8" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><Image Source="Assets/Currencies/mythic-essence.png" Width="24" Height="24" AutomationProperties.Name="Mythic Essence icon"/><TextBlock Text="Mythic Essence" Style="{StaticResource MutedText}" Margin="8,2,6,0"/><TextBlock Text="{Binding MythicEssence}" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border></StackPanel><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding LootQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search crafting inventory"/><ComboBox Grid.Column="1" ItemsSource="{Binding LootCategories}" SelectedItem="{Binding LootCategory}" Margin="10,0,0,0" AutomationProperties.Name="Crafting category"/><TextBlock Grid.Column="2" Text="{Binding LootCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><ListBox Grid.Row="4" ItemsSource="{Binding LootRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:ArtworkImage AssetPath="{Binding First.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}" Height="76"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding First.Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding First.Quantity}" Foreground="{StaticResource HighlightBrush}"/><TextBlock Text="{Binding First.Subtitle}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding First.Values}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border><Border Grid.Column="2" Visibility="{Binding Second, Converter={StaticResource NullVisibility}}" Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:ArtworkImage AssetPath="{Binding Second.Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}" Height="76"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding Second.Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Second.Quantity}" Foreground="{StaticResource HighlightBrush}"/><TextBlock Text="{Binding Second.Subtitle}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Second.Values}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
    </TabControl>
  </Grid>
</Window>
