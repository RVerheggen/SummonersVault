<Window x:Class="SummonersVault.App.AccountDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SummonersVault.App.Controls" xmlns:externalProfiles="clr-namespace:SummonersVault.Application.ExternalProfiles;assembly=SummonersVault.Application" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="League account details" Width="1120" Height="800" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
  <Grid Background="{StaticResource BackgroundBrush}" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><TextBlock Text="SV" Foreground="{StaticResource HighlightBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Account.ProfileIconBytes, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill"/></Grid></Border>
      <StackPanel Grid.Column="1" Margin="16,0">
        <TextBlock Text="{Binding RiotId}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ProfileLine}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding RoleLine}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding LastPlayed}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding SyncSummary}" Foreground="{StaticResource HighlightBrush}" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding IsSynchronizationInProgress, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="Account synchronization status" AutomationProperties.LiveSetting="Polite">
          <Ellipse Width="7" Height="7" Fill="{StaticResource HighlightBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding SynchronizationStatus}" Style="{StaticResource MutedText}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Image Source="Assets/Currencies/rp.png" Width="22" Height="22"/><TextBlock Text="{Binding RiotPoints}" Margin="7,2,18,0"/><Image Source="Assets/Currencies/blue-essence.png" Width="22" Height="22"/><TextBlock Text="{Binding BlueEssence}" Margin="7,2,0,0"/></StackPanel>
        <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Content="Copy username" AutomationProperties.Name="Copy username" Click="CopyUsername_Click"/>
          <Button Content="Copy password" AutomationProperties.Name="Copy password" Click="CopyPassword_Click" Margin="8,0,0,0"/>
          <Button Content="Sync" AutomationProperties.Name="Synchronize account" Click="Sync_Click" Margin="8,0,0,0"/>
          <Button Content="Open League" AutomationProperties.Name="Open League" Click="OpenLeague_Click" Margin="8,0,0,0"/>
          <Button AutomationProperties.Name="View external League statistics" Click="ViewStats_Click" Margin="8,0,0,0" Visibility="{Binding ShowExternalProfileLinks, Converter={StaticResource BooleanVisibility}}" IsEnabled="{Binding CanOpenExternalProfileLinks}" ToolTip="{Binding ExternalProfileLinksToolTip}" ToolTipService.ShowOnDisabled="True">
            <Button.ContextMenu>
              <ContextMenu Style="{StaticResource AppContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="DeepLoL" Style="{StaticResource AppMenuItem}" Tag="{x:Static externalProfiles:ExternalProfileProvider.DeepLol}" Click="OpenExternalProfile_Click" AutomationProperties.Name="Open DeepLoL profile in browser" Visibility="{Binding ShowDeepLolProfileLink, Converter={StaticResource BooleanVisibility}}"/>
                <MenuItem Header="DPM.LOL" Style="{StaticResource AppMenuItem}" Tag="{x:Static externalProfiles:ExternalProfileProvider.DpmLol}" Click="OpenExternalProfile_Click" AutomationProperties.Name="Open DPM.LOL profile in browser" Visibility="{Binding ShowDpmLolProfileLink, Converter={StaticResource BooleanVisibility}}"/>
                <MenuItem Header="LeagueOfGraphs" Style="{StaticResource AppMenuItem}" Tag="{x:Static externalProfiles:ExternalProfileProvider.LeagueOfGraphs}" Click="OpenExternalProfile_Click" AutomationProperties.Name="Open LeagueOfGraphs profile in browser" Visibility="{Binding ShowLeagueOfGraphsProfileLink, Converter={StaticResource BooleanVisibility}}"/>
                <MenuItem Header="OP.GG" Style="{StaticResource AppMenuItem}" Tag="{x:Static externalProfiles:ExternalProfileProvider.OpGg}" Click="OpenExternalProfile_Click" AutomationProperties.Name="Open OP.GG profile in browser" Visibility="{Binding ShowOpGgProfileLink, Converter={StaticResource BooleanVisibility}}"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><TextBlock Text="View stats"/><iconPacks:PackIconFontAwesome Kind="ArrowUpRightFromSquareSolid" Width="12" Height="12" Margin="8,1,0,0" Foreground="{StaticResource MutedForegroundBrush}" Focusable="False" IsHitTestVisible="False"/></StackPanel>
          </Button>
          <Button Content="Edit" AutomationProperties.Name="Edit account" Click="Edit_Click" Margin="8,0,0,0"/>
        </WrapPanel>
      </StackPanel>
    </Grid></Border>
    <TabControl Grid.Row="2" AutomationProperties.Name="Account details sections">
      <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Overview" Style="{StaticResource SectionHeading}"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="NOTES" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,10,0,0"/><Separator Margin="0,18"/><TextBlock Text="{Binding OwnershipSummary}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SyncSummary}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding LastPlayed}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Champions">
        <Grid Margin="20">
          <Grid x:Name="ChampionGallery" Visibility="{Binding IsChampionGalleryVisible, Converter={StaticResource BooleanVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding ChampionCollections}" SelectedItem="{Binding ChampionCollection}" AutomationProperties.Name="Champion collection" Background="{StaticResource TransparentBrush}" BorderThickness="0">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="True"/><Setter Property="IsTabStop" Value="True"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Segment" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource HighlightBrush}"/><Setter TargetName="Segment" Property="BorderThickness" Value="2"/><Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource HighlightBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            </ListBox>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ChampionQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search champions"/><ComboBox Grid.Column="1" ItemsSource="{Binding ChampionSortOptions}" SelectedItem="{Binding ChampionSort}" Margin="10,0,0,0" AutomationProperties.Name="Sort champions by"/><ComboBox Grid.Column="2" ItemsSource="{Binding ChampionSortDirections}" SelectedItem="{Binding ChampionSortDirection}" Margin="10,0,0,0" AutomationProperties.Name="Champion sort direction"/><TextBlock Grid.Column="3" Text="{Binding ChampionCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid>
            <ListBox Grid.Row="4" ItemsSource="{Binding ChampionRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.GalleryColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource GalleryCardButton}" Height="238" Tag="{Binding}" Click="ChampionCard_Click" AutomationProperties.Name="{Binding Name}">
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <controls:ArtworkImage AssetPath="{Binding Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="14,10">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <Border Visibility="{Binding IsClassic, Converter={StaticResource BooleanVisibility}}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CLASSIC" Foreground="{StaticResource HighlightBrush}" FontSize="10" FontWeight="SemiBold"/>
                                  </Border>
                                </StackPanel>
                                <DockPanel Margin="0,7,0,0"><Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="8" Padding="7,3"><TextBlock Text="{Binding MasteryLevel}" Foreground="{StaticResource HighlightBrush}" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding MasteryPoints}" Style="{StaticResource MutedText}" Margin="8,3,0,0"/></DockPanel>
                                <TextBlock Text="{Binding EternalProgress}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <ScrollViewer Visibility="{Binding IsChampionProgressionVisible, Converter={StaticResource BooleanVisibility}}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <Button Content="Back to champions" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="ChampionBack_Click" AutomationProperties.Name="Back to champion collection"/>
              <Border Style="{StaticResource Panel}" Padding="0" Height="320" Margin="0,12,0,16">
                <Grid>
                  <controls:ArtworkImage AssetPath="{Binding SelectedChampion.Artwork}" ArtworkService="{Binding ArtworkService}" AllowCommunityDragon="{Binding AllowCommunityDragon}"/>
                  <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18,13" Margin="18" MinWidth="310">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedChampion.Name}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Visibility="{Binding SelectedChampion.IsClassic, Converter={StaticResource BooleanVisibility}}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="CLASSIC" Foreground="{StaticResource HighlightBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding SelectedChampion.MasteryPoints}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding SelectedChampion.ProgressionStatus}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Panel}" Margin="0,0,8,0"><StackPanel><TextBlock Text="MASTERY" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedChampion.MasteryLevel}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedChampion.HighestGrade}" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedChampion.MasteryProgress}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedChampion.LastMasteryPlay}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}" Margin="8,0,0,0"><StackPanel><TextBlock Text="ETERNALS" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedChampion.EternalProgress}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Owned Eternals are grouped below. Retired progression is marked Legacy." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel></Border></Grid>
              <TextBlock Text="{Binding SelectedChampion.EternalEmptyMessage}" Style="{StaticResource MutedText}" Margin="4,16"/>
              <ItemsControl ItemsSource="{Binding SelectedChampion.EternalSets}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,12"/><ItemsControl ItemsSource="{Binding Eternals}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/><TextBlock Margin="0,6,0,0"><Run Text="Value "/><Run Text="{Binding FormattedValue}"/><Run Text=" · Milestone "/><Run Text="{Binding MilestoneLevel}"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="FEATURED" Visibility="{Binding IsFeatured, Converter={StaticResource BooleanVisibility}}" Foreground="{StaticResource HighlightBrush}" Margin="8,0"/><TextBlock Text="COMPLETE" Visibility="{Binding IsComplete, Converter={StaticResource BooleanVisibility}}" Foreground="{StaticResource SuccessBrush}" Margin="8,0"/><TextBlock Text="LEGACY" Visibility="{Binding IsRetired, Converter={StaticResource BooleanVisibility}}" Foreground="{StaticResource WarningBrush}" Margin="8,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Skins">
        <Grid Margin="20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SkinQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search skins and champions"/>
            <TextBlock Grid.Column="1" Text="{Binding SkinCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding SkinRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.GalleryColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Panel}" Padding="0" Height="190">
                        <Grid>
                          <controls:ArtworkImage AssetPath="{Binding Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}" Padding="14,8">
                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/></StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
      <TabItem Header="Ranked">
        <ListBox ItemsSource="{Binding RankRows}" Margin="20" Background="{StaticResource TransparentBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.GalleryColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Panel}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}" Width="72" Height="72" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Queue}" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding RankText}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Record}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding WinRate}" Style="{StaticResource MutedText}"/>
                          <TextBlock Text="{Binding Placement}" Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Crafting">
        <Grid Margin="20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Border Style="{StaticResource Panel}" Padding="12,8"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Currencies/orange-essence.png" Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.Name="Orange Essence icon"/><TextBlock Text="Orange Essence" Style="{StaticResource MutedText}" Margin="8,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding OrangeEssence}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
            <Border Style="{StaticResource Panel}" Padding="12,8" Margin="10,0,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Currencies/mythic-essence.png" Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.Name="Mythic Essence icon"/><TextBlock Text="Mythic Essence" Style="{StaticResource MutedText}" Margin="8,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding MythicEssence}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border>
          </StackPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding LootQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search crafting inventory"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding LootCategories}" SelectedItem="{Binding LootCategory}" Margin="10,0,0,0" AutomationProperties.Name="Crafting category"/>
            <TextBlock Grid.Column="2" Text="{Binding LootCount}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ListBox Grid.Row="4" ItemsSource="{Binding LootRows}" Background="{StaticResource TransparentBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding DataContext.CraftingColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Panel}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
                          <controls:ArtworkImage AssetPath="{Binding Artwork}" ArtworkService="{Binding DataContext.ArtworkService, RelativeSource={RelativeSource AncestorType=Window}}" AllowCommunityDragon="{Binding DataContext.AllowCommunityDragon, RelativeSource={RelativeSource AncestorType=Window}}" Height="76"/>
                          <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource HighlightBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Values}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
