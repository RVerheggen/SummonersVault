<UserControl x:Class="SummonersVault.App.Controls.EmptyStatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False">
    <Grid Background="{StaticResource TransparentBrush}">
        <Border Style="{StaticResource Panel}" MaxWidth="520"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="14"
                        HorizontalAlignment="Center">
                    <Path Data="M 6,0 L 12,6 L 6,12 L 0,6 Z"
                          Width="14" Height="14" Stretch="Uniform"
                          Stroke="{StaticResource HighlightBrush}" StrokeThickness="1.6"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          SnapsToDevicePixels="True"/>
                </Border>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource MutedText}" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
