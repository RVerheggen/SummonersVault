<Window x:Class="SummonersVault.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SummonersVault update"
        Width="620" Height="520" MinWidth="520" MinHeight="420"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16">
        <Border Style="{StaticResource Panel}" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Text="Update available" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,6,0,18"/>
                <Border Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReleaseNotes" AutomationProperties.Name="Release notes"/>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="The update will download only after you continue."/>
                    <ProgressBar x:Name="DownloadProgress" Height="10" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Update download progress"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="LaterButton" Content="Later" AutomationProperties.Name="Update later" Click="Later_Click"/>
                    <Button x:Name="DownloadButton" Content="Download and install" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" AutomationProperties.Name="Download and install update" Click="Download_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
