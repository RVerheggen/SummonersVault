<Window x:Class="SummonersVault.App.PasswordPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Backup password" Width="440" Height="270" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Unlock imported backup" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Enter the backup’s original master password." Style="{StaticResource MutedText}" Margin="0,6,0,18"/><TextBlock Text="Master password" Margin="0,0,0,6"/><PasswordBox x:Name="Password" AutomationProperties.Name="Backup master password"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True"/><Button Content="Continue" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Continue_Click"/></StackPanel></StackPanel></Border></Grid>
</Window>
