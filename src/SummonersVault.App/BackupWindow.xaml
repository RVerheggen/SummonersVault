<Window x:Class="SummonersVault.App.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import / Export"
        Width="760" Height="620" MinWidth="650" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="4,2,4,22">
            <TextBlock Text="Import / Export" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Move or restore your encrypted vault without exposing account credentials."
                       Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="EXPORT ENCRYPTED BACKUP" Foreground="{StaticResource HighlightBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Create a portable .svault backup" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,7"/>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="The backup can be imported on another Windows PC. You will need the original master password to unlock it."/>
                        </StackPanel>
                        <Button x:Name="ExportButton" Grid.Column="1" Content="Export backup"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                Click="Export_Click" AutomationProperties.Name="Export encrypted vault backup"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="IMPORT ENCRYPTED BACKUP" Foreground="{StaticResource HighlightBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Merge accounts from a .svault backup" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,7"/>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Accounts that are not already present are added. You choose what to keep when a matching account is found."/>
                        </StackPanel>
                        <Button x:Name="ImportButton" Grid.Column="1" Content="Import backup"
                                VerticalAlignment="Center" Click="Import_Click"
                                AutomationProperties.Name="Import encrypted vault backup"/>
                    </Grid>
                </Border>

                <Border x:Name="StatusPanel" Visibility="Collapsed"
                        Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusSymbol" Text="◇" Foreground="{StaticResource HighlightBrush}"
                                   FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"
                                   AutomationProperties.Name="Operation status indicator"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="OperationProgress" Height="6" IsIndeterminate="True"
                                         Visibility="Collapsed" Margin="0,10,0,0"
                                         AutomationProperties.Name="Backup operation progress"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="CloseButton" Grid.Row="2" Content="Close" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,18,0,0"
                AutomationProperties.Name="Close Import and Export"/>
    </Grid>
</Window>
