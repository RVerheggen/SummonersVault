<Window x:Class="SummonersVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SummonersVault.App.ViewModels"
        xmlns:conv="clr-namespace:SummonersVault.App.Converters"
        Title="SummonersVault" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <conv:ByteArrayImageConverter x:Key="ImageConverter"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroVisibility"/>
        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
        <DataTemplate x:Key="AuthBrand">
            <Border Style="{StaticResource Panel}" Padding="42" Margin="0,0,28,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1">
                            <TextBlock Text="SV" Foreground="{StaticResource HighlightBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,7,0,0"><TextBlock Text="SUMMONERSVAULT" FontWeight="SemiBold"/><TextBlock Text="LOCAL LEAGUE VAULT" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Every summoner.&#10;One quiet vault." FontSize="40" FontWeight="SemiBold" LineHeight="48"/>
                        <TextBlock Text="Credentials and League snapshots stay on this PC." Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" Width="430" HorizontalAlignment="Left" Margin="0,18,0,28"/>
                        <TextBlock Text="◇  Encrypted on this PC" Margin="0,0,0,10"/>
                        <TextBlock Text="◇  Read-only League Client sync" Margin="0,0,0,10"/>
                        <TextBlock Text="◇  No telemetry or cloud account"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="LOCAL  •  ENCRYPTED  •  WINDOWS 11" Foreground="{StaticResource HighlightBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid Margin="40" MaxWidth="1120" HorizontalAlignment="Center" Visibility="{Binding IsOnboarding, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="460"/></Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource AuthBrand}"/>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="36" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CREATE YOUR VAULT" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="Start securely" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,8"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="There is no recovery key. Keep your master password somewhere safe." Margin="0,0,0,24"/>
                    <TextBlock Text="Master password" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="CreatePassword" AutomationProperties.Name="New master password"/>
                    <TextBlock Text="Confirm password" Margin="0,16,0,6"/>
                    <PasswordBox x:Name="CreateConfirmation" AutomationProperties.Name="Confirm master password"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Minimum 8 characters. A 12+ character passphrase is recommended." FontSize="12" Margin="0,10,0,20"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Create encrypted vault" Click="CreateVault_Click"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="40" MaxWidth="1120" HorizontalAlignment="Center" Visibility="{Binding IsLocked, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource AuthBrand}"/>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="36" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="WELCOME BACK" Foreground="{StaticResource HighlightBrush}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="Unlock your vault" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,8"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Enter your master password to restore this local session." Margin="0,0,0,24"/>
                    <TextBlock Text="Master password" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="UnlockPassword" AutomationProperties.Name="Master password" KeyDown="UnlockPassword_KeyDown"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Unlock vault" Margin="0,18,0,0" Click="UnlockVault_Click"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="24" Visibility="{Binding IsVault, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="SV" Foreground="{StaticResource HighlightBrush}" FontSize="28" FontWeight="Bold"/><TextBlock Text="SUMMONERSVAULT" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="LOCAL LEAGUE VAULT" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,34,0,0">
                        <Button Style="{StaticResource SidebarSelectedButton}" AutomationProperties.Name="Vault"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="26" TextAlignment="Center"/><TextBlock Text="Vault"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" AutomationProperties.Name="Settings" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="26" TextAlignment="Center"/><TextBlock Text="Settings"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" AutomationProperties.Name="Import or export" Click="Backup_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⇅" Width="26" TextAlignment="Center"/><TextBlock Text="Import / Export"/></StackPanel></Button>
                        <Button Style="{StaticResource SidebarButton}" AutomationProperties.Name="About" Click="About_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" Width="26" TextAlignment="Center"/><TextBlock Text="About"/></StackPanel></Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock Text="●  LEAGUE CLIENT" Foreground="{StaticResource HighlightBrush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding ClientStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,12" AutomationProperties.LiveSetting="Polite"/><Button Content="Lock vault" Click="Lock_Click"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SEARCH" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search accounts" ToolTip="Search name, notes, region, rank, champion, skin, or role"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="SORT BY" Style="{StaticResource FilterLabel}"/><ComboBox SelectedIndex="0" SelectionChanged="Sort_SelectionChanged"><ComboBoxItem Content="Name"/><ComboBoxItem Content="Recently played"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text=" " Style="{StaticResource FilterLabel}"/><Button Style="{StaticResource PrimaryButton}" Content="＋ Add account" Click="AddAccount_Click"/></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Width="108" Margin="0,0,8,0"><TextBlock Text="REGION" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding RegionFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by region"/></StackPanel>
                        <StackPanel Width="126" Margin="0,0,8,0"><TextBlock Text="QUEUE / TIER" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding RankFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by queue or tier"/></StackPanel>
                        <StackPanel Width="108" Margin="0,0,8,0"><TextBlock Text="ROLE" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding RoleFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by role"/></StackPanel>
                        <StackPanel Width="126" Margin="0,0,8,0"><TextBlock Text="CHAMPION" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding ChampionFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by champion"/></StackPanel>
                        <StackPanel Width="126" Margin="0,0,8,0"><TextBlock Text="SKIN" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding SkinFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter by skin"/></StackPanel>
                        <StackPanel Width="132"><TextBlock Text="SYNC STATE" Style="{StaticResource FilterLabel}"/><ComboBox SelectedIndex="{Binding SyncFilterIndex}"><ComboBoxItem Content="Any sync"/><ComboBoxItem Content="Known"/><ComboBoxItem Content="Never played"/><ComboBoxItem Content="Not synced"/><ComboBoxItem Content="Stale"/></ComboBox></StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Border Panel.ZIndex="1" Style="{StaticResource Panel}" Visibility="{Binding Accounts.Count, Converter={StaticResource ZeroVisibility}}" MaxWidth="560" MaxHeight="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" Foreground="{StaticResource HighlightBrush}" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="Your vault is ready" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,6"/><TextBlock Text="Add an account, then optionally link it to the signed-in League Client." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="390"/><Button Style="{StaticResource PrimaryButton}" Content="Add your first account" AutomationProperties.Name="Add your first account" Margin="0,20,0,0" HorizontalAlignment="Center" Click="AddAccount_Click"/></StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:AccountCardViewModel}"><Border Style="{StaticResource Panel}" Width="414" Margin="0,0,16,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><TextBlock Text="SV" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}" FontWeight="Bold"/><Image Source="{Binding Icon, Converter={StaticResource ImageConverter}}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding RiotId}" Style="{StaticResource MutedText}"/></StackPanel></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="{Binding Region}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/><TextBlock Text="  •  "/><TextBlock Text="{Binding Rank}"/><TextBlock Text="  •  "/><TextBlock Text="{Binding Roles}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="{Binding LastPlayed}" ToolTip="{Binding LastPlayedTooltip}"/><TextBlock Text="{Binding Notes}" Style="{StaticResource MutedText}" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel><WrapPanel Grid.Row="3"><Button Content="Details" Tag="{Binding Id}" Click="EditAccount_Click"/><Button Content="Copy username" AutomationProperties.Name="Copy username" Tag="{Binding Id}" Click="CopyLogin_Click" Margin="8,0,0,0"/><Button Content="Copy password" Tag="{Binding Id}" Click="CopyPassword_Click" Margin="8,0,0,0"/><Button Content="Open League" Tag="{Binding Id}" Click="Launch_Click" Margin="0,8,8,0"/><Button Content="Sync" Tag="{Binding Id}" Click="Sync_Click" Margin="0,8,0,0"/></WrapPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
